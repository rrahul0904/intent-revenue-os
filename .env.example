# Persistent data
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intent_revenue_os

# Authentication adapter.
# demo is for local development only. Use a trusted auth adapter before production.
AUTH_MODE=demo
DEMO_USER_ID=demo-founder
DEMO_USER_NAME=Demo Founder
ALLOW_DEMO_AUTH_IN_PRODUCTION=false

# Application
APP_BASE_URL=http://localhost:3000

# Website intelligence
WEBSITE_FETCH_ENABLED=true
WEBSITE_FETCH_TIMEOUT_MS=12000
WEBSITE_FETCH_MAX_BYTES=1200000
WEBSITE_FETCH_USER_AGENT=SignalOS/0.4 (+https://github.com/rrahul0904/intent-revenue-os)

# Reddit Data API
# External/commercial use must comply with Reddit's current Data API / Developer Terms
# and may require a separate Reddit agreement. The adapter is disabled unless BOTH
# switches below are explicitly true.
REDDIT_API_ENABLED=false
REDDIT_COMMERCIAL_ACCESS_APPROVED=false
REDDIT_ACCESS_TOKEN=
REDDIT_USER_AGENT=SignalOS/0.4 by rrahul0904
REDDIT_SEARCH_LIMIT=50

# Worker
WORKER_ID=
WORKER_POLL_MS=2000
WORKER_LEASE_SECONDS=120
WORKER_MAX_JOBS_PER_LOOP=25

# Phase 3 intent enrichment
# heuristic is fully local/deterministic. openai uses the Responses API with strict structured output.
AI_MODE=heuristic
CLASSIFIER_VERSION=phase3-v1
LEAD_MIN_SCORE=55
LEAD_MIN_CONFIDENCE=55
AI_REQUEST_TIMEOUT_MS=30000

# Required only when AI_MODE=openai
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional cost accounting. Set current contracted/model rates in USD per 1M tokens.
AI_INPUT_USD_PER_MILLION=0
AI_OUTPUT_USD_PER_MILLION=0
AI_CACHED_INPUT_USD_PER_MILLION=0
